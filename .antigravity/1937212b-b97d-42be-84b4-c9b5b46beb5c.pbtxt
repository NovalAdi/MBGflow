enter justify-between text-sm\">\n                    <span className=\"text-slate-500\">Total Staff Assigned</span>\n                    <span className=\"font-bold text-slate-800\">{shift.staffCount} Orang</span>\n                  </div>\n                  <div className=\"flex items-center -space-x-2\">\n                    {shift.avatars.map((av: string, idx: number) => (\n                      <img key={idx} src={av} className=\"w-8 h-8 rounded-full border-2 border-white ring-1 ring-slate-100\" referrerPolicy=\"no-referrer\" />\n                    ))}\n                    <div className=\"w-8 h-8 rounded-full bg-slate-100 border-2 border-white flex items-center justify-center text-[10px] font-bold text-slate-400\">\n                    +{shift.staffCount - shift.avatars.length}\n                    </div>\n                  </div>\n                </div>\n              </Card>\n            ))}\n          </div>\n        )}\n\n        {activeTab === \'Stok\' && (\n          <div className=\"space-y-6\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-lg font-bold text-slate-700\">Kitchen Stock Monitor</h3>\n              <Button variant=\"outline\" size=\"sm\">\n                <Warehouse className=\"w-4 h-4 mr-2\" />\n                Request Bahan\n              </Button>\n            </div>\n            <div className=\"grid grid-cols-1 gap-4\">\n              {detail.stock?.map((item: InventoryItem) => (\n                <StockRow key={item.id} item={item} />\n              ))}\n            </div>\n          </div>\n        )}\n      </div>\n"
