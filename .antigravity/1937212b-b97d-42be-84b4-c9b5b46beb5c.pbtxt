    content: "import * as React from \"react\";\nimport { Card } from \"../../components/ui/Card\";\nimport { Badge } from \"../../components/ui/Badge\";\nimport { PieChart, Pie, Cell, ResponsiveContainer, Tooltip, Legend } from \'recharts\';\nimport { FileWarning, AlertOctagon, UserCheck, Search } from \"lucide-react\";\n\nconst wastageStats = [\n  { name: \'Expired\', value: 45, color: \'#F43F5E\' },\n  { name: \'Human Error\', value: 30, color: \'#4F46E5\' },\n  { name: \'Damage/Spoiled\', value: 25, color: \'#F59E0B\' },\n];\n\nconst mockAuditData = [\n  { id: \'W1\', kitchen: \'Jakarta Main\', material: \'Ayam Negri\', weight: \'5 kg\', reason: \'Expired\', cost: \'Rp 250k\', date: \'2024-05-18\' },\n  { id: \'W2\', kitchen: \'Tangerang Satellite\', material: \'Beras Pandan\', weight: \'10 kg\', reason: \'Human Error\', cost: \'Rp 150k\', date: \'2024-05-18\' },\n  { id: \'W3\', kitchen: \'Depok Cloud\', material: \'Minyak Goreng\', weight: \'2 L\', reason: \'Damage\', cost: \'Rp 40k\', date: \'2024-05-17\' },\n];\n\nexport const WastageReport = () => {\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-2xl font-bold text-slate-800\">Laporan Wastage Nasional</h2>\n          <p className=\"text-slate-500\">Monitor and audit waste efficiency across all production units</p>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Badge status=\"Audit Mode\" />\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        {/* Wastage Summary Chart */}\n        <Card className=\"lg:col-span-1 flex flex-col items-center justify-center p-8\">\n          <h3 className=\"font-bold text-slate-800 mb-2 self-start\">Wastage Summary</h3>\n          <p className=\"text-sm text-slate-500 mb-8 self-start\">By Loss Reason Category</p>\n          <div className=\"w-full h-[250px]\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={wastageStats}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={60}\n                  outerRadius={80}\n                  paddingAngle={8}\n                  dataKey=\"value\"\n                >\n                  {wastageStats.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.color} stroke=\"none\" />\n                  ))}\n                </Pie>\n                <Tooltip />\n              </PieChart>\n            </ResponsiveContainer>\n          </div>\n          <div className=\"w-full space-y-3 mt-4\">\n            {wastageStats.map(stat => (\n              <div key={stat.name} className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-3 h-3 rounded-full\" style={{ backgroundColor: stat.color }} />\n                  <span className=\"text-xs font-medium text-slate-600\">{stat.name}</span>\n                </div>\n                <span className=\"text-xs font-bold text-slate-800\">{stat.value}%</span>\n              </div>\n            ))}\n          </div>\n        </Card>\n\n        {/* Global Wastage Table */}\n        <Card className=\"lg:col-span-2 p-0 overflow-hidden flex flex-col\">\n          <div className=\"p-6 border-b border-border flex items-center justify-between bg-slate-50/50\">\n            <h3 className=\"font-bold text-text-main text-base\">Global Wastage Table</h3>\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n              <input \n                type=\"text\" \n                placeholder=\"Search audit records...\" \n                className=\"pl-10 pr-4 py-2 bg-white border border-border rounded-lg text-xs focus:ring-2 focus:ring-primary/20 outline-none\" \n              />\n            </div>\n          </div>\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full\">\n              <thead>\n                <tr className=\"bg-white border-b border-border\">\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Kitchen</th>\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Material</th>\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Loss Reason</th>\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Weight/Vol</th>\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Est. Cost</th>\n                  <th className=\"text-right p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Date</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-border\">\n                {mockAuditData.map((row) => (\n                  <tr key={row.id} className=\"hover:bg-slate-50 transition-colors\">\n                    <td className=\"p-4\">\n                      <p className=\"font-bold text-slate-800 text-sm\">{row.kitchen}</p>\n                    </td>\n                    <td className=\"p-4\">\n                      <p className=\"text-slate-600 text-sm font-medium\">{row.material}</p>\n                    </td>\n                    <td className=\"p-4\">\n                      <div className=\"flex items-center gap-1.5 self-start\">\n                        {row.reason === \'Expired\' && <AlertOctagon className=\"w-3 h-3 text-red-500\" />}\n                        {row.reason === \'Human Error\' && <UserCheck className=\"w-3 h-3 text-indigo-500\" />}\n                        <span className=\"text-xs font-semibold\">{row.reason}</span>\n                      </div>\n                    </td>\n                    <td className=\"p-4\">\n                      <span className=\"text-sm font-bold text-slate-800\">{row.weight}</span>\n                    </td>\n                    <td className=\"p-4\">\n                      <span className=\"text-sm font-bold text-red-600\">{row.cost}</span>\n                    </td>\n                    <td className=\"p-4 text-right\">\n                      <span className=\"text-xs text-slate-400 font-medium\">{row.date}</span>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </Card>\n      </div>\n    </div>\n  );\n};\n"
    raw_content: "import * as React from \"react\";\nimport { Card } from \"../../components/ui/Card\";\nimport { Badge } from \"../../components/ui/Badge\";\nimport { PieChart, Pie, Cell, ResponsiveContainer, Tooltip, Legend } from \'recharts\';\nimport { FileWarning, AlertOctagon, UserCheck, Search } from \"lucide-react\";\n\nconst wastageStats = [\n  { name: \'Expired\', value: 45, color: \'#F43F5E\' },\n  { name: \'Human Error\', value: 30, color: \'#4F46E5\' },\n  { name: \'Damage/Spoiled\', value: 25, color: \'#F59E0B\' },\n];\n\nconst mockAuditData = [\n  { id: \'W1\', kitchen: \'Jakarta Main\', material: \'Ayam Negri\', weight: \'5 kg\', reason: \'Expired\', cost: \'Rp 250k\', date: \'2024-05-18\' },\n  { id: \'W2\', kitchen: \'Tangerang Satellite\', material: \'Beras Pandan\', weight: \'10 kg\', reason: \'Human Error\', cost: \'Rp 150k\', date: \'2024-05-18\' },\n  { id: \'W3\', kitchen: \'Depok Cloud\', material: \'Minyak Goreng\', weight: \'2 L\', reason: \'Damage\', cost: \'Rp 40k\', date: \'2024-05-17\' },\n];\n\nexport const WastageReport = () => {\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-2xl font-bold text-slate-800\">Laporan Wastage Nasional</h2>\n          <p className=\"text-slate-500\">Monitor and audit waste efficiency across all production units</p>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <Badge status=\"Audit Mode\" />\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        {/* Wastage Summary Chart */}\n        <Card className=\"lg:col-span-1 flex flex-col items-center justify-center p-8\">\n          <h3 className=\"font-bold text-slate-800 mb-2 self-start\">Wastage Summary</h3>\n          <p className=\"text-sm text-slate-500 mb-8 self-start\">By Loss Reason Category</p>\n          <div className=\"w-full h-[250px]\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={wastageStats}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={60}\n                  outerRadius={80}\n                  paddingAngle={8}\n                  dataKey=\"value\"\n                >\n                  {wastageStats.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.color} stroke=\"none\" />\n                  ))}\n                </Pie>\n                <Tooltip />\n              </PieChart>\n            </ResponsiveContainer>\n          </div>\n          <div className=\"w-full space-y-3 mt-4\">\n            {wastageStats.map(stat => (\n              <div key={stat.name} className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-3 h-3 rounded-full\" style={{ backgroundColor: stat.color }} />\n                  <span className=\"text-xs font-medium text-slate-600\">{stat.name}</span>\n                </div>\n                <span className=\"text-xs font-bold text-slate-800\">{stat.value}%</span>\n              </div>\n            ))}\n          </div>\n        </Card>\n\n        {/* Global Wastage Table */}\n        <Card className=\"lg:col-span-2 p-0 overflow-hidden flex flex-col\">\n          <div className=\"p-6 border-b border-border flex items-center justify-between bg-slate-50/50\">\n            <h3 className=\"font-bold text-text-main text-base\">Global Wastage Table</h3>\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted\" />\n              <input \n                type=\"text\" \n                placeholder=\"Search audit records...\" \n                className=\"pl-10 pr-4 py-2 bg-white border border-border rounded-lg text-xs focus:ring-2 focus:ring-primary/20 outline-none\" \n              />\n            </div>\n          </div>\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full\">\n              <thead>\n                <tr className=\"bg-white border-b border-border\">\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Kitchen</th>\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Material</th>\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Loss Reason</th>\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Weight/Vol</th>\n                  <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Est. Cost</th>\n                  <th className=\"text-right p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Date</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-border\">\n                {mockAuditData.map((row) => (\n                  <tr key={row.id} className=\"hover:bg-slate-50 transition-colors\">\n                    <td className=\"p-4\">\n                      <p className=\"font-bold text-slate-800 text-sm\">{row.kitchen}</p>\n                    </td>\n                    <td className=\"p-4\">\n                      <p className=\"text-slate-600 text-sm font-medium\">{row.material}</p>\n                    </td>\n                    <td className=\"p-4\">\n                      <div className=\"flex items-center gap-1.5 self-start\">\n                        {row.reason === \'Expired\' && <AlertOctagon className=\"w-3 h-3 text-red-500\" />}\n                        {row.reason === \'Human Error\' && <UserCheck className=\"w-3 h-3 text-indigo-500\" />}\n                        <span className=\"text-xs font-semibold\">{row.reason}</span>\n                      </div>\n                    </td>\n                    <td className=\"p-4\">\n                      <span className=\"text-sm font-bold text-slate-800\">{row.weight}</span>\n                    </td>\n                    <td className=\"p-4\">\n                      <span className=\"text-sm font-bold text-red-600\">{row.cost}</span>\n                    </td>\n                    <td className=\"p-4 text-right\">\n                      <span className=\"text-xs text-slate-400 font-medium\">{row.date}</span>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </Card>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 130
    num_bytes: 6432
  }
}
