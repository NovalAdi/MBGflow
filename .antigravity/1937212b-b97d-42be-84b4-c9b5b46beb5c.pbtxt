rc={s.avatar} className=\"w-10 h-10 rounded-full border border-slate-200\" referrerPolicy=\"no-referrer\" />\n                        </td>\n                        <td className=\"p-4 font-bold text-slate-800\">{s.name}</td>\n                        <td className=\"p-4\">\n                          <Badge status={s.role} />\n                        </td>\n                        <td className=\"p-4\">\n                          <div className=\"flex items-center gap-1.5 font-medium text-xs text-green-600\">\n                            <span className=\"w-2 h-2 rounded-full bg-green-500\" />\n                            {s.status}\n                          </div>\n                        </td>\n                        <td className=\"p-4 text-right space-x-2\">\n                          <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 transition-opacity\">\n                            <Edit2 className=\"w-4 h-4 text-slate-400\" />\n                          </Button>\n                          <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 transition-opacity\">\n                            <Trash2 className=\"w-4 h-4 text-red-400\" />\n                          </Button>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </Card>\n            </motion.div>\n          )}\n\n          {activeTab === \'Shift\' && (\n            <motion.div \n              key=\"shift\"\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              className=\"grid grid-cols-1 md:grid-cols-2 gap-6\"\n            >\n              {detail.shifts?.map((shift: any, i: number) => (\n                <Card key={i} className=\"p-6 relative overflow-hidden group\">\n                  <div className=\"absolute top-0 right-0 p-4 opacity-5\">\n                    <History className=\"w-24 h-24\" />\n                  </div>\n                  <div className=\"flex justify-between items-start mb-6\">\n                    <div>\n                      <h4 className=\"text-xl font-bold text-slate-800\">{shift.type}</h4>\n                      <p className=\"text-sm font-medium text-slate-400\">{shift.time}</p>\n                    </div>\n                    <Badge status=\"Scheduled\" />\n                  </div>\n                  <div className=\"space-y-4\">\n                    <div className=\"flex items-center justify-between text-sm\">\n                      <span className=\"text-slate-500\">Total Staff Assigned</span>\n                      <span className=\"font-bold text-slate-800\">{shift.staffCount} Orang</span>\n                    </div>\n                    <div className=\"flex items-center -space-x-2\">\n                      {shift.avatars.map((av: string, idx: number) => (\n                        <img key={idx} src={av} className=\"w-8 h-8 rounded-full border-2 border-white ring-1 ring-slate-100\" referrerPolicy=\"no-referrer\" />\n                      ))}\n                      <div className=\"w-8 h-8 rounded-full bg-slate-100 border-2 border-white flex items-center justify-center text-[10px] font-bold text-slate-400\">\n                      +{shift.staffCount - shift.avatars.length}\n                      </div>\n                    </div>\n                  </div>\n                </Card>\n              ))}\n            </motion.div>\n          )}\n\n          {activeTab === \'Stok\' && (\n            <motion.div \n              key=\"stok\"\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              className=\"space-y-6\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-lg font-bold text-slate-700\">Kitchen Stock Monitor</h3>\n                <Button variant=\"outline\" size=\"sm\">\n                  <Warehouse className=\"w-4 h-4 mr-2\" />\n                  Request Bahan\n                </Button>\n              </div>\n              <div className=\"grid grid-cols-1 gap-4\">\n                {detail.stock?.map((item: InventoryItem) => (\n                  <StockRow key={item.id} item={item} />\n                ))}\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </div>\n"
        replacement_content: "      {/* Tab Content */}\n      <div className=\"min-h-[400px]\">\n        {activeTab === \'Staff\' && (\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-lg font-bold text-slate-700\">Kitchen Staff Member</h3>\n              <Button onClick={() => setStaffModalOpen(true)}>\n                <Plus className=\"w-4 h-4 mr-2\" />\n                Tambah Staff\n              </Button>\n            </div>\n            <Card className=\"p-0 overflow-hidden\">\n              <table className=\"w-full\">\n                <thead>\n                  <tr className=\"bg-slate-50 border-b border-border\">\n                    <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Avatar</th>\n                    <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Nama Lengkap</th>\n                    <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Role</th>\n                    <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Status</th>\n                    <th className=\"text-right p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Aksi</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-border\">\n                  {detail.staff?.map((s: any) => (\n                    <tr key={s.id} className=\"hover:bg-slate-50/50 transition-colors group\">\n                      <td className=\"p-4\">\n                        <img src={s.avatar} className=\"w-10 h-10 rounded-full border border-slate-200\" referrerPolicy=\"no-referrer\" />\n                      </td>\n                      <td className=\"p-4 font-bold text-slate-800\">{s.name}</td>\n                      <td className=\"p-4\">\n                        <Badge status={s.role} />\n                      </td>\n                      <td className=\"p-4\">\n                        <div className=\"flex items-center gap-1.5 font-medium text-xs text-green-600\">\n                          <span className=\"w-2 h-2 rounded-full bg-green-500\" />\n                          {s.status}\n                        </div>\n                      </td>\n                      <td className=\"p-4 text-right space-x-2\">\n                        <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 transition-opacity\">\n                          <Edit2 className=\"w-4 h-4 text-slate-400\" />\n                        </Button>\n                        <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 transition-opacity\">\n                          <Trash2 className=\"w-4 h-4 text-red-400\" />\n                        </Button>\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </Card>\n          </div>\n        )}\n\n        {activeTab === \'Shift\' && (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {detail.shifts?.map((shift: any, i: number) => (\n              <Card key={i} className=\"p-6 relative overflow-hidden group\">\n                <div className=\"absolute top-0 right-0 p-4 opacity-5\">\n                  <History className=\"w-24 h-24\" />\n                </div>\n                <div className=\"flex justify-between items-start mb-6\">\n                  <div>\n                    <h4 className=\"text-xl font-bold text-slate-800\">{shift.type}</h4>\n                    <p className=\"text-sm font-medium text-slate-400\">{shift.time}</p>\n                  </div>\n                  <Badge status=\"Scheduled\" />\n                </div>\n                <div className=\"space-y-4\">\n                  <div className=\"flex items-center justify-between text-sm\">\n                    <span className=\"text-slate-500\">Total Staff Assigned</span>\n                    <span className=\"font-bold text-slate-800\">{shift.staffCount} Orang</span>\n                  </div>\n                  <div className=\"flex items-center -space-x-2\">\n                    {shift.avatars.map((av: string, idx: number) => (\n                      <img key={idx} src={av} className=\"w-8 h-8 rounded-full border-2 border-white ring-1 ring-slate-100\" referrerPolicy=\"no-referrer\" />\n                    ))}\n                    <div className=\"w-8 h-8 rounded-full bg-slate-100 border-2 border-white flex items-center justify-center text-[10px] font-bold text-slate-400\">\n                    +{shift.staffCount - shift.avatars.length}\n                    </div>\n                  </div>\n                </div>\n              </Card>\n            ))}\n          </div>\n        )}\n\n        {activeTab === \'Stok\' && (\n          <div className=\"space-y-6\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-lg font-bold text-slate-700\">Kitchen Stock Monitor</h3>\n              <Button variant=\"outline\" size=\"sm\">\n                <Warehouse className=\"w-4 h-4 mr-2\" />\n                Request Bahan\n              </Button>\n            </div>\n            <div className=\"grid grid-cols-1 gap-4\">\n              {detail.stock?.map((item: InventoryItem) => (\n                <StockRow key={item.id} item={item} />\n              ))}\n            </div>\n          </div>\n        )}\n      </div>\n"
      }
      num_matches: 1
    }
