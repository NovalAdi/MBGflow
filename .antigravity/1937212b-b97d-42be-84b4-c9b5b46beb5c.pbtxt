  view_file {
    absolute_path_uri: "file:///src/pages/admin/Dashboard.tsx"
    end_line: 141
    content: "import * as React from \"react\";\nimport { api } from \"../../services/api\";\nimport { ReportSummary, ProductionLog } from \"../../types\";\nimport { Card } from \"../../components/ui/Card\";\nimport { Badge } from \"../../components/ui/Badge\";\nimport { Button } from \"../../components/ui/Button\";\nimport { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid } from \'recharts\';\nimport { Users, Utensils, UtensilsCrossed, TrendingUp, History, ChevronRight } from \"lucide-react\";\nimport { format } from \"date-fns\";\nimport { cn } from \"../../lib/utils\";\n\nconst mockProgressData = [\n  { hour: \'08:00\', target: 120, real: 110 },\n  { hour: \'10:00\', target: 200, real: 185 },\n  { hour: \'12:00\', target: 450, real: 462 },\n  { hour: \'14:00\', target: 300, real: 280 },\n  { hour: \'16:00\', target: 150, real: 140 },\n];\n\nexport const AdminDashboard = () => {\n  const [stats, setStats] = React.useState<ReportSummary | null>(null);\n  const [activities, setActivities] = React.useState<ProductionLog[]>([]);\n\n  React.useEffect(() => {\n    api.getStats().then(setStats);\n    api.getActivity().then(setActivities);\n  }, []);\n\n  if (!stats) {\n    return (\n      <div className=\"flex h-[50vh] items-center justify-center\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-12 h-12 border-4 border-primary border-t-transparent rounded-full animate-spin\"></div>\n          <p className=\"font-semibold text-text-muted\">Loading Dashboard Data...</p>\n        </div>\n      </div>\n    );\n  }\n\n  const statCards = [\n    { label: \"Total Dapur Aktif\", value: stats.activeKitchens, icon: UtensilsCrossed, color: \"bg-blue-500\" },\n    { label: \"Porsi Sukses Hari Ini\", value: stats.successfulServings, icon: TrendingUp, color: \"bg-green-500\" },\n    { label: \"Porsi Sedang Dimasak\", value: stats.currentlyCooking, icon: Utensils, color: \"bg-indigo-500\" },\n    { label: \"Koki Bertugas\", value: stats.chefsOnDuty, icon: Users, color: \"bg-orange-500\" },\n  ];\n\n  return (\n    <div className=\"space-y-8 max-w-7xl mx-auto\">\n      {/* Stat Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px]\">\n        {statCards.map((stat, i) => (\n          <div key={i} className=\"bg-white p-[20px] rounded-xl border border-border flex items-center gap-[16px] shadow-sm shadow-slate-100 transition-all hover:shadow-md\">\n            <div className=\"w-[48px] h-[48px] bg-[#EEF2FF] rounded-[12px] flex items-center justify-center text-primary shrink-0\">\n              <stat.icon className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <p className=\"text-[12px] font-medium text-text-muted mb-[4px] uppercase tracking-wide\">{stat.label}</p>\n              <h3 className=\"text-[20px] font-bold text-slate-800\">{stat.value.toLocaleString()}</h3>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-[24px]\">\n        {/* Activity Feed */}\n        <Card className=\"lg:col-span-1 p-0 flex flex-col h-[500px]\">\n          <div className=\"p-[16px_20px] border-b border-border flex items-center justify-between\">\n            <h3 className=\"widget-title text-[16px] font-semibold text-slate-800\">Live Cooking Activity</h3>\n            <span className=\"text-[12px] text-primary font-semibold\">Real-time Feed</span>\n          </div>\n          <div className=\"flex-1 overflow-y-auto activity-list\">\n            {activities.map((act) => (\n              <div key={act.id} className=\"activity-item p-[16px_20px] border-b border-border flex items-center gap-[16px] last:border-b-0\">\n                <div className=\"menu-thumb w-[40px] h-[40px] bg-[#E2E8F0] rounded-full flex items-center justify-center font-bold text-text-muted shrink-0 text-xs\">\n                  {act.menu.split(\' \').map(n => n[0]).join(\'\').substring(0, 2).toUpperCase()}\n                </div>\n                <div className=\"activity-info flex-1\">\n                  <div className=\"menu-name text-[14px] font-semibold text-slate-800\">{act.menu}</div>\n                  <div className=\"kitchen-name text-[12px] text-text-muted\">{act.kitchen} \342\200\242 Batch #{Math.floor(Math.random() * 900 + 100)}</div>\n                </div>\n                <Badge status={act.status} />\n              </div>\n            ))}\n          </div>\n        </Card>\n\n        {/* Daily Progress Chart */}\n        <div className=\"lg:col-span-2 flex flex-col gap-[24px]\">\n          <Card className=\"p-0 flex flex-col flex-1\">\n            <div className=\"p-[16px_20px] border-b border-border flex items-center justify-between\">\n              <h3 className=\"widget-title text-[16px] font-semibold text-slate-800\">Daily Progress</h3>\n            </div>\n            <div className=\"flex-1 p-[20px] pb-1 min-h-[250px]\">\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <BarChart data={mockProgressData}>\n                  <XAxis dataKey=\"hour\" axisLine={false} tickLine={false} tick={{ fill: \'#64748B\', fontSize: 10 }} dy={8} />\n                  <YAxis hide />\n                  <Tooltip \n                    cursor={{ fill: \'#F1F5F9\' }}\n                    contentStyle={{ borderRadius: \'8px\', border: \'none\', boxShadow: \'0 4px 6px -1px rgb(0 0 0 / 0.1)\' }}\n                  />\n                  <Bar dataKey=\"real\" name=\"Realisasi\" fill=\"#4F46E5\" radius={[4, 4, 0, 0]} barSize={40} />\n                </BarChart>\n              </ResponsiveContainer>\n            </div>\n            <div className=\"p-[0_20px_20px] text-[12px] text-text-muted\">\n              Target: 1,500 Porsi / Hari \342\200\242 <strong>82% Terpenuhi</strong>\n            </div>\n          </Card>\n\n          <Card className=\"p-0 overflow-hidden\">\n            <div className=\"p-[16px_20px] border-b border-border\">\n              <h3 className=\"widget-title text-[16px] font-semibold text-slate-800\">Audit & Compliance</h3>\n            </div>\n            <div className=\"p-[16px_20px] space-y-3\">\n              <div className=\"flex justify-between items-center text-[13px]\">\n                <span>Pending QA Checks</span>\n                <span className=\"font-bold text-warning\">05</span>\n              </div>\n              <div className=\"flex justify-between items-center text-[13px]\">\n                <span>Low Stock Alerts</span>\n                <span className=\"font-bold text-red-500\">02</span>\n              </div>\n            </div>\n            <button className=\"history-btn w-full p-4 bg-[#F1F5F9] text-center text-primary font-semibold text-[13px] hover:bg-[#E2E8F0] transition-colors border-t border-border\">\n              Access Production History\n            </button>\n          </Card>\n        </div>\n      </div>\n\n      {/* Action Footer */}\n      <div className=\"flex justify-end\">\n        <Button variant=\"primary\" className=\"shadow-lg shadow-primary/30 py-6 px-8 rounded-2xl\">\n          Akses Tabel Histori Produksi\n          <ChevronRight className=\"w-5 h-5 ml-2\" />\n        </Button>\n      </div>\n    </div>\n  );\n};\n"
    raw_content: "import * as React from \"react\";\nimport { api } from \"../../services/api\";\nimport { ReportSummary, ProductionLog } from \"../../types\";\nimport { Card } from \"../../components/ui/Card\";\nimport { Badge } from \"../../components/ui/Badge\";\nimport { Button } from \"../../components/ui/Button\";\nimport { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid } from \'recharts\';\nimport { Users, Utensils, UtensilsCrossed, TrendingUp, History, ChevronRight } from \"lucide-react\";\nimport { format } from \"date-fns\";\nimport { cn } from \"../../lib/utils\";\n\nconst mockProgressData = [\n  { hour: \'08:00\', target: 120, real: 110 },\n  { hour: \'10:00\', target: 200, real: 185 },\n  { hour: \'12:00\', target: 450, real: 462 },\n  { hour: \'14:00\', target: 300, real: 280 },\n  { hour: \'16:00\', target: 150, real: 140 },\n];\n\nexport const AdminDashboard = () => {\n  const [stats, setStats] = React.useState<ReportSummary | null>(null);\n  const [activities, setActivities] = React.useState<ProductionLog[]>([]);\n\n  React.useEffect(() => {\n    api.getStats().then(setStats);\n    api.getActivity().then(setActivities);\n  }, []);\n\n  if (!stats) {\n    return (\n      <div className=\"flex h-[50vh] items-center justify-center\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-12 h-12 border-4 border-primary border-t-transparent rounded-full animate-spin\"></div>\n          <p className=\"font-semibold text-text-muted\">Loading Dashboard Data...</p>\n        </div>\n      </div>\n    );\n  }\n\n  const statCards = [\n    { label: \"Total Dapur Aktif\", value: stats.activeKitchens, icon: UtensilsCrossed, color: \"bg-blue-500\" },\n    { label: \"Porsi Sukses Hari Ini\", value: stats.successfulServings, icon: TrendingUp, color: \"bg-green-500\" },\n    { label: \"Porsi Sedang Dimasak\", value: stats.currentlyCooking, icon: Utensils, color: \"bg-indigo-500\" },\n    { label: \"Koki Bertugas\", value: stats.chefsOnDuty, icon: Users, color: \"bg-orange-500\" },\n  ];\n\n  return (\n    <div className=\"space-y-8 max-w-7xl mx-auto\">\n      {/* Stat Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px]\">\n        {statCards.map((stat, i) => (\n          <div key={i} className=\"bg-white p-[20px] rounded-xl border border-border flex items-center gap-[16px] shadow-sm shadow-slate-100 transition-all hover:shadow-md\">\n            <div className=\"w-[48px] h-[48px] bg-[#EEF2FF] rounded-[12px] flex items-center justify-center text-primary shrink-0\">\n              <stat.icon className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <p className=\"text-[12px] font-medium text-text-muted mb-[4px] uppercase tracking-wide\">{stat.label}</p>\n              <h3 className=\"text-[20px] font-bold text-slate-800\">{stat.value.toLocaleString()}</h3>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-[24px]\">\n        {/* Activity Feed */}\n        <Card className=\"lg:col-span-1 p-0 flex flex-col h-[500px]\">\n          <div className=\"p-[16px_20px] border-b border-border flex items-center justify-between\">\n            <h3 className=\"widget-title text-[16px] font-semibold text-slate-800\">Live Cooking Activity</h3>\n            <span className=\"text-[12px] text-primary font-semibold\">Real-time Feed</span>\n          </div>\n          <div className=\"flex-1 overflow-y-auto activity-list\">\n            {activities.map((act) => (\n              <div key={act.id} className=\"activity-item p-[16px_20px] border-b border-border flex items-center gap-[16px] last:border-b-0\">\n                <div className=\"menu-thumb w-[40px] h-[40px] bg-[#E2E8F0] rounded-full flex items-center justify-center font-bold text-text-muted shrink-0 text-xs\">\n                  {act.menu.split(\' \').map(n => n[0]).join(\'\').substring(0, 2).toUpperCase()}\n                </div>\n                <div className=\"activity-info flex-1\">\n                  <div className=\"menu-name text-[14px] font-semibold text-slate-800\">{act.menu}</div>\n                  <div className=\"kitchen-name text-[12px] text-text-muted\">{act.kitchen} \342\200\242 Batch #{Math.floor(Math.random() * 900 + 100)}</div>\n                </div>\n                <Badge status={act.status} />\n              </div>\n            ))}\n          </div>\n        </Card>\n\n        {/* Daily Progress Chart */}\n        <div className=\"lg:col-span-2 flex flex-col gap-[24px]\">\n          <Card className=\"p-0 flex flex-col flex-1\">\n            <div className=\"p-[16px_20px] border-b border-border flex items-center justify-between\">\n              <h3 className=\"widget-title text-[16px] font-semibold text-slate-800\">Daily Progress</h3>\n            </div>\n            <div className=\"flex-1 p-[20px] pb-1 min-h-[250px]\">\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <BarChart data={mockProgressData}>\n                  <XAxis dataKey=\"hour\" axisLine={false} tickLine={false} tick={{ fill: \'#64748B\', fontSize: 10 }} dy={8} />\n                  <YAxis hide />\n                  <Tooltip \n                    cursor={{ fill: \'#F1F5F9\' }}\n                    contentStyle={{ borderRadius: \'8px\', border: \'none\', boxShadow: \'0 4px 6px -1px rgb(0 0 0 / 0.1)\' }}\n                  />\n                  <Bar dataKey=\"real\" name=\"Realisasi\" fill=\"#4F46E5\" radius={[4, 4, 0, 0]} barSize={40} />\n                </BarChart>\n              </ResponsiveContainer>\n            </div>\n            <div className=\"p-[0_20px_20px] text-[12px] text-text-muted\">\n              Target: 1,500 Porsi / Hari \342\200\242 <strong>82% Terpenuhi</strong>\n            </div>\n          </Card>\n\n          <Card className=\"p-0 overflow-hidden\">\n            <div className=\"p-[16px_20px] border-b border-border\">\n              <h3 className=\"widget-title text-[16px] font-semibold text-slate-800\">Audit & Compliance</h3>\n            </div>\n            <div className=\"p-[16px_20px] space-y-3\">\n              <div className=\"flex justify-between items-center text-[13px]\">\n                <span>Pending QA Checks</span>\n                <span className=\"font-bold text-warning\">05</span>\n              </div>\n              <div className=\"flex justify-between items-center text-[13px]\">\n                <span>Low Stock Alerts</span>\n                <span className=\"font-bold text-red-500\">02</span>\n              </div>\n            </div>\n            <button className=\"history-btn w-full p-4 bg-[#F1F5F9] text-center text-primary font-semibold text-[13px] hover:bg-[#E2E8F0] transition-colors border-t border-border\">\n              Access Production History\n            </button>\n          </Card>\n        </div>\n      </div>\n\n      {/* Action Footer */}\n      <div className=\"flex justify-end\">\n        <Button variant=\"primary\" className=\"shadow-lg shadow-primary/30 py-6 px-8 rounded-2xl\">\n          Akses Tabel Histori Produksi\n          <ChevronRight className=\"w-5 h-5 ml-2\" />\n        </Button>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 142
    num_bytes: 6955
  }
}
