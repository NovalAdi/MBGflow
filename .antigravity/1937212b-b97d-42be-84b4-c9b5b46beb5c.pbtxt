    content: "    res.json({ success: true, handoverId: `H-${Date.now()}` });\n  });\n\n  // --- Vite / Static Files ---\n\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Server running at http://0.0.0.0:${PORT}`);\n  });\n}"
    raw_content: "import express from \"express\";\nimport { createServer as createViteServer } from \"vite\";\nimport path from \"path\";\nimport { fileURLToPath } from \"url\";\n\n// Force development mode for Vite middleware in AI Studio preview\nprocess.env.NODE_ENV = \'development\';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  app.use(express.json());\n\n  // --- Mock Database State ---\n  let kitchens = [\n    { id: \"k1\", name: \"Central Kitchen Jakarta\", address: \"Grogol, Jakarta Barat\", capacity: 85 },\n    { id: \"k2\", name: \"Satellite Kitchen Tangerang\", address: \"BSD, Tangerang Selatan\", capacity: 40 },\n  ];\n\n  let productionLogs = [\n    { id: \"p1\", menu: \"Ayam Penyet\", kitchen: \"Jakarta\", status: \"Cooking\", servings: 50, startTime: new Date().toISOString() },\n    { id: \"p2\", menu: \"Nasi Goreng Special\", kitchen: \"Tangerang\", status: \"Ready\", servings: 30, startTime: new Date().toISOString() },\n  ];\n\n  let stockRequests = [];\n  let wastageRecords = [];\n\n  // --- API Routes ---\n\n  app.get(\"/api/health\", (req, res) => {\n    res.json({ status: \"ok\" });\n  });\n\n  app.get(\"/api/dashboard/stats\", (req, res) => {\n    res.json({\n      activeKitchens: kitchens.length,\n      successfulServings: 1250,\n      currentlyCooking: productionLogs.filter(p => p.status === \'Cooking\').length,\n      chefsOnDuty: 12\n    });\n  });\n\n  app.get(\"/api/dashboard/activity\", (req, res) => {\n    res.json(productionLogs);\n  });\n\n  app.get(\"/api/kitchens\", (req, res) => {\n    res.json(kitchens);\n  });\n\n  app.get(\"/api/kitchens/:id\", (req, res) => {\n    const kitchen = kitchens.find(k => k.id === req.params.id);\n    if (!kitchen) return res.status(404).json({ error: \"Kitchen not found\" });\n    \n    // Detailed tabs data\n    res.json({\n      ...kitchen,\n      staff: [\n        { id: \'s1\', name: \'Andi Pratama\', role: \'Head Chef\', status: \'Active\', avatar: \'https://i.pravatar.cc/150?u=s1\' },\n        { id: \'s2\', name: \'Budi Santoso\', role: \'Sous Chef\', status: \'Active\', avatar: \'https://i.pravatar.cc/150?u=s2\' },\n      ],\n      shifts: [\n        { type: \'Pagi\', time: \'06:00 - 14:00\', staffCount: 6, avatars: [\'https://i.pravatar.cc/150?u=a1\', \'https://i.pravatar.cc/150?u=a2\'] },\n        { type: \'Siang\', time: \'14:00 - 22:00\', staffCount: 8, avatars: [\'https://i.pravatar.cc/150?u=a3\', \'https://i.pravatar.cc/150?u=a4\'] },\n      ],\n      stock: [\n        { id: \'i1\', name: \'Ayam Negri\', volume: 80, batches: [\n          { id: \'b1\', container: \'Box A1\', weight: \'5 kg\', expiry: \'2024-05-20\' },\n          { id: \'b2\', container: \'Box A2\', weight: \'10 kg\', expiry: \'2024-05-22\' }\n        ]},\n        { id: \'i2\', name: \'Beras Pandan Wangi\', volume: 45, batches: [] }\n      ]\n    });\n  });\n\n  app.post(\"/api/production/request-stock\", (req, res) => {\n    const { material, amount, urgency } = req.body;\n    const newRequest = { id: Date.now().toString(), material, amount, urgency, status: \'Pending\', createdAt: new Date().toISOString() };\n    stockRequests.push(newRequest);\n    res.status(201).json(newRequest);\n  });\n\n  app.post(\"/api/chef/finish-task\", (req, res) => {\n    const { productionId, temp, notes, returnedStock } = req.body;\n    // Logical update for returned stock would go here\n    res.json({ success: true, handoverId: `H-${Date.now()}` });\n  });\n\n  // --- Vite / Static Files ---\n\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Server running at http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
    num_lines: 115
    num_bytes: 3913
  }
}
