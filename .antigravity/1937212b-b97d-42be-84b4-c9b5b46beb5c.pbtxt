  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 60
    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport * as React from \"react\";\nimport { BrowserRouter, Routes, Route, Navigate, useNavigate } from \"react-router-dom\";\nimport { Shell } from \"./components/layout/Shell\";\nimport { AdminDashboard } from \"./pages/admin/Dashboard\";\nimport { ProductionPlanning } from \"./pages/admin/Planning\";\nimport { KitchenDetail } from \"./pages/admin/KitchenDetail\";\nimport { WastageReport } from \"./pages/admin/WastageReport\";\nimport { ChefQueue } from \"./pages/chef/Queue\";\nimport { ChefStock } from \"./pages/chef/Stock\";\n\nconst AppContent = () => {\n  const [role, setRole] = React.useState<\'Admin\' | \'Chef\'>(\'Admin\');\n  \n  const switchRole = () => {\n    const nextRole = role === \'Admin\' ? \'Chef\' : \'Admin\';\n    setRole(nextRole);\n  };\n\n  return (\n    <Shell role={role} onSwitchRole={switchRole}>\n      <Routes>\n        {/* Admin Routes */}\n        {role === \'Admin\' && (\n          <>\n            <Route path=\"/admin\" element={<AdminDashboard />} />\n            <Route path=\"/admin/planning\" element={<ProductionPlanning />} />\n            <Route path=\"/admin/kitchens\" element={<KitchenDetail />} />\n            <Route path=\"/admin/reports\" element={<WastageReport />} />\n          </>\n        )}\n\n        {/* Chef Routes */}\n        {role === \'Chef\' && (\n          <>\n            <Route path=\"/chef/queue\" element={<ChefQueue />} />\n            <Route path=\"/chef/stock\" element={<ChefStock />} />\n          </>\n        )}\n        \n        {/* Global Fallback */}\n        <Route path=\"/\" element={<Navigate to={role === \'Admin\' ? \"/admin\" : \"/chef/queue\"} replace />} />\n        <Route path=\"*\" element={<Navigate to=\"/\" replace />} />\n      </Routes>\n    </Shell>\n  );\n};\n\nexport default function App() {\n  return (\n    <BrowserRouter>\n      <AppContent />\n    </BrowserRouter>\n  );\n}\n\n"
    raw_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport * as React from \"react\";\nimport { BrowserRouter, Routes, Route, Navigate, useNavigate } from \"react-router-dom\";\nimport { Shell } from \"./components/layout/Shell\";\nimport { AdminDashboard } from \"./pages/admin/Dashboard\";\nimport { ProductionPlanning } from \"./pages/admin/Planning\";\nimport { KitchenDetail } from \"./pages/admin/KitchenDetail\";\nimport { WastageReport } from \"./pages/admin/WastageReport\";\nimport { ChefQueue } from \"./pages/chef/Queue\";\nimport { ChefStock } from \"./pages/chef/Stock\";\n\nconst AppContent = () => {\n  const [role, setRole] = React.useState<\'Admin\' | \'Chef\'>(\'Admin\');\n  \n  const switchRole = () => {\n    const nextRole = role === \'Admin\' ? \'Chef\' : \'Admin\';\n    setRole(nextRole);\n  };\n\n  return (\n    <Shell role={role} onSwitchRole={switchRole}>\n      <Routes>\n        {/* Admin Routes */}\n        {role === \'Admin\' && (\n          <>\n            <Route path=\"/admin\" element={<AdminDashboard />} />\n            <Route path=\"/admin/planning\" element={<ProductionPlanning />} />\n            <Route path=\"/admin/kitchens\" element={<KitchenDetail />} />\n            <Route path=\"/admin/reports\" element={<WastageReport />} />\n          </>\n        )}\n\n        {/* Chef Routes */}\n        {role === \'Chef\' && (\n          <>\n            <Route path=\"/chef/queue\" element={<ChefQueue />} />\n            <Route path=\"/chef/stock\" element={<ChefStock />} />\n          </>\n        )}\n        \n        {/* Global Fallback */}\n        <Route path=\"/\" element={<Navigate to={role === \'Admin\' ? \"/admin\" : \"/chef/queue\"} replace />} />\n        <Route path=\"*\" element={<Navigate to=\"/\" replace />} />\n      </Routes>\n    </Shell>\n  );\n};\n\nexport default function App() {\n  return (\n    <BrowserRouter>\n      <AppContent />\n    </BrowserRouter>\n  );\n}\n\n"
    num_lines: 61
