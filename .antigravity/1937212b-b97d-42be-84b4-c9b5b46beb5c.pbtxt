      arguments_json: "{\"Instruction\":\"Simplifying App.tsx to a bare minimal version to verify if React can render ANY content in the current environment.\",\"ReplacementContent\":\"import * as React from \\\"react\\\";\\n\\nexport default function App() {\\n  return (\\n    <div style={{ \\n      height: \'100vh\', \\n      display: \'flex\', \\n      flexDirection: \'column\',\\n      alignItems: \'center\', \\n      justifyContent: \'center\',\\n      background: \'#f8fafc\',\\n      fontFamily: \'sans-serif\'\\n    }}>\\n      <h1 style={{ color: \'#4f46e5\', fontSize: \'2.5rem\', marginBottom: \'1rem\' }}>KitchenPro System</h1>\\n      <p style={{ color: \'#64748b\' }}>System Core is Running. Diagnostic Phase 1.</p>\\n      <div style={{ \\n        marginTop: \'2rem\', \\n        padding: \'1rem\', \\n        border: \'1px solid #e2e8f0\', \\n        borderRadius: \'8px\',\\n        background: \'white\'\\n      }}>\\n        Status: <span style={{ color: \'#22c55e\', fontWeight: \'bold\' }}>Mounted Successfully</span>\\n      </div>\\n    </div>\\n  );\\n}\\n\",\"TargetContent\":\"import * as React from \\\"react\\\";\\nimport { BrowserRouter, Routes, Route, Navigate, useNavigate } from \\\"react-router-dom\\\";\\nimport { Shell } from \\\"./components/layout/Shell\\\";\\nimport { AdminDashboard } from \\\"./pages/admin/Dashboard\\\";\\nimport { ProductionPlanning } from \\\"./pages/admin/Planning\\\";\\nimport { KitchenDetail } from \\\"./pages/admin/KitchenDetail\\\";\\nimport { WastageReport } from \\\"./pages/admin/WastageReport\\\";\\nimport { ChefQueue } from \\\"./pages/chef/Queue\\\";\\nimport { ChefStock } from \\\"./pages/chef/Stock\\\";\\n\\nconst AppContent = () => {\\n  const [role, setRole] = React.useState<\'Admin\' | \'Chef\'>(\'Admin\');\\n  \\n  const switchRole = () => {\\n    const nextRole = role === \'Admin\' ? \'Chef\' : \'Admin\';\\n    setRole(nextRole);\\n  };\\n\\n  return (\\n    <Shell role={role} onSwitchRole={switchRole}>\\n      <Routes>\\n        {/* Admin Routes */}\\n        {role === \'Admin\' && (\\n          <>\\n            <Route path=\\\"/admin\\\" element={<AdminDashboard />} />\\n            <Route path=\\\"/admin/planning\\\" element={<ProductionPlanning />} />\\n            <Route path=\\\"/admin/kitchens\\\" element={<KitchenDetail />} />\\n            <Route path=\\\"/admin/reports\\\" element={<WastageReport />} />\\n          </>\\n        )}\\n\\n        {/* Chef Routes */}\\n        {role === \'Chef\' && (\\n          <>\\n            <Route path=\\\"/chef/queue\\\" element={<ChefQueue />} />\\n            <Route path=\\\"/chef/stock\\\" element={<ChefStock />} />\\n          </>\\n        )}\\n        \\n        {/* Global Fallback */}\\n        <Route path=\\\"/\\\" element={<Navigate to={role === \'Admin\' ? \\\"/admin\\\" : \\\"/chef/queue\\\"} replace />} />\\n        <Route path=\\\"*\\\" element={<Navigate to=\\\"/\\\" replace />} />\\n      </Routes>\\n    </Shell>\\n  );\\n};\\n\\nexport default function App() {\\n  return (\\n    <BrowserRouter>\\n      <AppContent />\\n    </BrowserRouter>\\n  );\\n}\\n\",\"TargetFile\":\"/src/App.tsx\",\"toolAction\":\"Reducing the application to a minimal test case to decouple core rendering from complex route and component logic during the troubleshooting phase\",\"toolSummary\":\"Basic App.tsx for Debugging\"}"
