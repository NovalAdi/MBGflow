  view_file {
    absolute_path_uri: "file:///src/pages/admin/KitchenDetail.tsx"
    end_line: 335
    content: "import * as React from \"react\";\nimport { Card } from \"../../components/ui/Card\";\nimport { Button } from \"../../components/ui/Button\";\nimport { Badge } from \"../../components/ui/Badge\";\nimport { Modal } from \"../../components/ui/Modal\";\nimport { api } from \"../../services/api\";\nimport { Kitchen, InventoryItem } from \"../../types\";\nimport { ArrowLeft, MapPin, Users, History, Warehouse, ChevronDown, Plus, Trash2, Edit2, Package } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { cn } from \"../../lib/utils\";\n\nexport const KitchenDetail = () => {\n  const [activeTab, setActiveTab] = React.useState<\'Staff\' | \'Shift\' | \'Stok\'>(\'Staff\');\n  const [kitchens, setKitchens] = React.useState<Kitchen[]>([]);\n  const [selectedKitchenId, setSelectedKitchenId] = React.useState<string>(\"k1\");\n  const [detail, setDetail] = React.useState<any>(null);\n  const [showDropdown, setShowDropdown] = React.useState(false);\n  const [isStaffModalOpen, setStaffModalOpen] = React.useState(false);\n\n  React.useEffect(() => {\n    api.getKitchens().then(setKitchens);\n  }, []);\n\n  React.useEffect(() => {\n    setDetail(null);\n    api.getKitchenDetail(selectedKitchenId).then(setDetail);\n  }, [selectedKitchenId]);\n\n  if (!detail) {\n    return (\n      <div className=\"flex h-[50vh] items-center justify-center\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-12 h-12 border-4 border-primary border-t-transparent rounded-full animate-spin\"></div>\n          <p className=\"font-semibold text-text-muted\">Fetching Kitchen Detail...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8\">\n      {/* Header Widget */}\n      <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-border\">\n        <div className=\"space-y-4 flex-1\">\n          <div className=\"flex items-center gap-2 text-text-muted\">\n            <Button variant=\"ghost\" size=\"sm\" className=\"p-1 -ml-2\">\n              <ArrowLeft className=\"w-5 h-5\" />\n            </Button>\n            <span className=\"text-sm font-medium\">Kembali ke Daftar</span>\n          </div>\n          <div className=\"flex items-center gap-4 group cursor-pointer relative\">\n            <h1 className=\"text-2xl font-bold text-text-main\">{detail.name}</h1>\n            <div className=\"relative\">\n              <Button \n                variant=\"secondary\" \n                size=\"sm\" \n                className=\"rounded-lg px-3 py-1 flex items-center gap-2 text-xs\"\n                onClick={() => setShowDropdown(!showDropdown)}\n              >\n                Ganti Dapur\n                <ChevronDown className={cn(\"w-3 h-3 transition-transform\", showDropdown && \"rotate-180\")} />\n              </Button>\n              {showDropdown && (\n                <div className=\"absolute top-full left-0 mt-2 w-64 bg-white shadow-xl rounded-lg border border-border z-50 overflow-hidden\">\n                  {kitchens.map(k => (\n                    <button \n                      key={k.id}\n                      onClick={() => { setSelectedKitchenId(k.id); setShowDropdown(false); }}\n                      className=\"w-full text-left p-4 hover:bg-slate-50 transition-colors border-b border-border last:border-0\"\n                    >\n                      <p className=\"font-bold text-sm\">{k.name}</p>\n                      <p className=\"text-[10px] text-text-muted\">{k.address}</p>\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n          </div>\n          <div className=\"flex items-center gap-4 text-text-muted\">\n            <div className=\"flex items-center gap-1 text-[13px]\">\n              <MapPin className=\"w-4 h-4\" />\n              {detail.address}\n            </div>\n            <div className=\"h-4 w-px bg-border\" />\n            <div className=\"flex-1 max-w-[200px] flex items-center gap-3\">\n              <div className=\"flex-1 h-1.5 bg-[#E2E8F0] rounded-full overflow-hidden\">\n                <div \n                  className=\"h-full bg-primary\" \n                  style={{ width: `${detail.capacity}%` }}\n                />\n              </div>\n              <span className=\"text-xs font-bold text-primary\">{detail.capacity}%</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Tab Switcher */}\n      <div className=\"flex items-center border-b border-border gap-1 w-full overflow-x-auto scrollbar-hide\">\n        {([\'Staff\', \'Shift\', \'Stok\'] as const).map((tab) => (\n          <button\n            key={tab}\n            onClick={() => setActiveTab(tab)}\n            className={cn(\n              \"px-8 py-4 text-sm font-bold transition-all relative whitespace-nowrap\",\n              activeTab === tab ? \"text-primary\" : \"text-text-muted hover:text-slate-600\"\n            )}\n          >\n            {tab}\n            {activeTab === tab && (\n              <motion.div layoutId=\"underline\" className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-primary\" />\n            )}\n          </button>\n        ))}\n      </div>\n\n      {/* Tab Content */}\n      <div className=\"min-h-[400px]\">\n        <AnimatePresence mode=\"wait\">\n          {activeTab === \'Staff\' && (\n            <motion.div \n              key=\"staff\"\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              className=\"space-y-4\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-lg font-bold text-slate-700\">Kitchen Staff Member</h3>\n                <Button onClick={() => setStaffModalOpen(true)}>\n                  <Plus className=\"w-4 h-4 mr-2\" />\n                  Tambah Staff\n                </Button>\n              </div>\n              <Card className=\"p-0 overflow-hidden\">\n                <table className=\"w-full\">\n                  <thead>\n                    <tr className=\"bg-slate-50 border-b border-border\">\n                      <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Avatar</th>\n                      <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Nama Lengkap</th>\n                      <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Role</th>\n                      <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Status</th>\n                      <th className=\"text-right p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Aksi</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-border\">\n                    {detail.staff?.map((s: any) => (\n                      <tr key={s.id} className=\"hover:bg-slate-50/50 transition-colors group\">\n                        <td className=\"p-4\">\n                          <img src={s.avatar} className=\"w-10 h-10 rounded-full border border-slate-200\" referrerPolicy=\"no-referrer\" />\n                        </td>\n                        <td className=\"p-4 font-bold text-slate-800\">{s.name}</td>\n                        <td className=\"p-4\">\n                          <Badge status={s.role} />\n                        </td>\n                        <td className=\"p-4\">\n                          <div className=\"flex items-center gap-1.5 font-medium text-xs text-green-600\">\n                            <span className=\"w-2 h-2 rounded-full bg-green-500\" />\n                            {s.status}\n                          </div>\n                        </td>\n                        <td className=\"p-4 text-right space-x-2\">\n                          <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 transition-opacity\">\n                            <Edit2 className=\"w-4 h-4 text-slate-400\" />\n                          </Button>\n                          <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 transition-opacity\">\n                            <Trash2 className=\"w-4 h-4 text-red-400\" />\n                          </Button>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </Card>\n            </motion.div>\n          )}\n\n          {activeTab === \'Shift\' && (\n            <motion.div \n              key=\"shift\"\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              className=\"grid grid-cols-1 md:grid-cols-2 gap-6\"\n            >\n              {detail.shifts?.map((shift: any, i: number) => (\n                <Card key={i} className=\"p-6 relative overflow-hidden group\">\n                  <div className=\"absolute top-0 right-0 p-4 opacity-5\">\n                    <History className=\"w-24 h-24\" />\n                  </div>\n                  <div className=\"flex justify-between items-start mb-6\">\n                    <div>\n                      <h4 className=\"text-xl font-bold text-slate-800\">{shift.type}</h4>\n                      <p className=\"text-sm font-medium text-slate-400\">{shift.time}</p>\n                    </div>\n                    <Badge status=\"Scheduled\" />\n                  </div>\n                  <div className=\"space-y-4\">\n                    <div className=\"flex items-center justify-between text-sm\">\n                      <span className=\"text-slate-500\">Total Staff Assigned</span>\n                      <span className=\"font-bold text-slate-800\">{shift.staffCount} Orang</span>\n                    </div>\n                    <div className=\"flex items-center -space-x-2\">\n                      {shift.avatars.map((av: string, idx: number) => (\n                        <img key={idx} src={av} className=\"w-8 h-8 rounded-full border-2 border-white ring-1 ring-slate-100\" referrerPolicy=\"no-referrer\" />\n                      ))}\n                      <div className=\"w-8 h-8 rounded-full bg-slate-100 border-2 border-white flex items-center justify-center text-[10px] font-bold text-slate-400\">\n                      +{shift.staffCount - shift.avatars.length}\n                      </div>\n                    </div>\n                  </div>\n                </Card>\n              ))}\n            </motion.div>\n          )}\n\n          {activeTab === \'Stok\' && (\n            <motion.div \n              key=\"stok\"\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              className=\"space-y-6\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-lg font-bold text-slate-700\">Kitchen Stock Monitor</h3>\n                <Button variant=\"outline\" size=\"sm\">\n                  <Warehouse className=\"w-4 h-4 mr-2\" />\n                  Request Bahan\n                </Button>\n              </div>\n              <div className=\"grid grid-cols-1 gap-4\">\n                {detail.stock?.map((item: InventoryItem) => (\n                  <StockRow key={item.id} item={item} />\n                ))}\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </div>\n\n      {/* Staff Modal */}\n      <Modal isOpen={isStaffModalOpen} onClose={() => setStaffModalOpen(false)} title=\"Tambah Staff Baru\">\n        <form className=\"space-y-4\">\n          <div className=\"space-y-1\">\n            <label className=\"text-sm font-bold text-slate-600\">Nama Lengkap</label>\n            <input type=\"text\" className=\"w-full border-2 border-slate-100 rounded-lg p-3\" placeholder=\"Masukkan nama...\" />\n          </div>\n          <div className=\"space-y-1\">\n            <label className=\"text-sm font-bold text-slate-600\">Role</label>\n            <select className=\"w-full border-2 border-slate-100 rounded-lg p-3\">\n              <option>Head Chef</option>\n              <option>Sous Chef</option>\n              <option>Prep Cook</option>\n            </select>\n          </div>\n          <Button className=\"w-full py-4 mt-6\">Simpan Staff</Button>\n        </form>\n      </Modal>\n    </div>\n  );\n};\n\nconst StockRow = ({ item }: { item: InventoryItem, key?: string }) => {\n  const [isOpen, setIsOpen] = React.useState(false);\n  \n  return (\n    <Card className=\"p-0 overflow-hidden transform-gpu\">\n      <div \n        className={cn(\n          \"p-6 flex items-center gap-6 cursor-pointer hover:bg-slate-50 transition-colors\",\n          isOpen && \"bg-slate-50\"\n        )}\n        onClick={() => setIsOpen(!isOpen)}\n      >\n        <div className=\"w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-orange-500 shrink-0\">\n          <Package className=\"w-6 h-6\" />\n        </div>\n        <div className=\"flex-1 min-w-0\">\n          <h4 className=\"font-bold text-slate-800\">{item.name}</h4>\n          <div className=\"flex items-center gap-3 mt-1\">\n            <div className=\"flex-1 h-1.5 bg-slate-200 rounded-full overflow-hidden\">\n              <div \n                className={cn(\"h-full\", item.volume < 30 ? \"bg-red-500\" : \"bg-green-500\")}\n                style={{ width: `${item.volume}%` }}\n              />\n            </div>\n            <span className=\"text-xs font-bold text-slate-400\">{item.volume}%</span>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <div className=\"text-right\">\n            <p className=\"text-xs font-bold text-slate-400 uppercase\">Batches</p>\n            <p className=\"font-bold text-slate-800\">{item.batches.length}</p>\n          </div>\n          <ChevronDown className={cn(\"w-5 h-5 text-slate-300 transition-transform\", isOpen && \"rotate-180\")} />\n        </div>\n      </div>\n      \n      <AnimatePresence>\n        {isOpen && (\n          <motion.div \n            initial={{ height: 0 }}\n            animate={{ height: \'auto\' }}\n            exit={{ height: 0 }}\n            className=\"overflow-hidden bg-slate-50/50\"\n          >\n            <div className=\"p-6 pt-0 space-y-2\">\n              {item.batches.length > 0 ? (\n                item.batches.map(b => (\n                  <div key={b.id} className=\"flex items-center justify-between p-3 bg-white border border-border rounded-lg shadow-sm text-sm\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"p-2 bg-slate-50 rounded-lg\">\n                        <Warehouse className=\"w-3 h-3 text-text-muted\" />\n                      </div>\n                      <span className=\"font-bold text-text-main\">{b.container}</span>\n                      <span className=\"text-text-muted\">\342\200\242</span>\n                      <span className=\"font-medium text-text-muted\">{b.weight}</span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-text-muted\">Exp:</span>\n                      <span className=\"font-bold text-text-main\">{b.expiry}</span>\n                    </div>\n                  </div>\n                ))\n              ) : (\n                <p className=\"text-center py-4 text-xs font-bold text-text-muted italic\">No detailed batch data available</p>\n              )}\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </Card>\n  );\n}\n"
    raw_content: "import * as React from \"react\";\nimport { Card } from \"../../components/ui/Card\";\nimport { Button } from \"../../components/ui/Button\";\nimport { Badge } from \"../../components/ui/Badge\";\nimport { Modal } from \"../../components/ui/Modal\";\nimport { api } from \"../../services/api\";\nimport { Kitchen, InventoryItem } from \"../../types\";\nimport { ArrowLeft, MapPin, Users, History, Warehouse, ChevronDown, Plus, Trash2, Edit2, Package } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { cn } from \"../../lib/utils\";\n\nexport const KitchenDetail = () => {\n  const [activeTab, setActiveTab] = React.useState<\'Staff\' | \'Shift\' | \'Stok\'>(\'Staff\');\n  const [kitchens, setKitchens] = React.useState<Kitchen[]>([]);\n  const [selectedKitchenId, setSelectedKitchenId] = React.useState<string>(\"k1\");\n  const [detail, setDetail] = React.useState<any>(null);\n  const [showDropdown, setShowDropdown] = React.useState(false);\n  const [isStaffModalOpen, setStaffModalOpen] = React.useState(false);\n\n  React.useEffect(() => {\n    api.getKitchens().then(setKitchens);\n  }, []);\n\n  React.useEffect(() => {\n    setDetail(null);\n    api.getKitchenDetail(selectedKitchenId).then(setDetail);\n  }, [selectedKitchenId]);\n\n  if (!detail) {\n    return (\n      <div className=\"flex h-[50vh] items-center justify-center\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-12 h-12 border-4 border-primary border-t-transparent rounded-full animate-spin\"></div>\n          <p className=\"font-semibold text-text-muted\">Fetching Kitchen Detail...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-7xl mx-auto space-y-8\">\n      {/* Header Widget */}\n      <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-border\">\n        <div className=\"space-y-4 flex-1\">\n          <div className=\"flex items-center gap-2 text-text-muted\">\n            <Button variant=\"ghost\" size=\"sm\" className=\"p-1 -ml-2\">\n              <ArrowLeft className=\"w-5 h-5\" />\n            </Button>\n            <span className=\"text-sm font-medium\">Kembali ke Daftar</span>\n          </div>\n          <div className=\"flex items-center gap-4 group cursor-pointer relative\">\n            <h1 className=\"text-2xl font-bold text-text-main\">{detail.name}</h1>\n            <div className=\"relative\">\n              <Button \n                variant=\"secondary\" \n                size=\"sm\" \n                className=\"rounded-lg px-3 py-1 flex items-center gap-2 text-xs\"\n                onClick={() => setShowDropdown(!showDropdown)}\n              >\n                Ganti Dapur\n                <ChevronDown className={cn(\"w-3 h-3 transition-transform\", showDropdown && \"rotate-180\")} />\n              </Button>\n              {showDropdown && (\n                <div className=\"absolute top-full left-0 mt-2 w-64 bg-white shadow-xl rounded-lg border border-border z-50 overflow-hidden\">\n                  {kitchens.map(k => (\n                    <button \n                      key={k.id}\n                      onClick={() => { setSelectedKitchenId(k.id); setShowDropdown(false); }}\n                      className=\"w-full text-left p-4 hover:bg-slate-50 transition-colors border-b border-border last:border-0\"\n                    >\n                      <p className=\"font-bold text-sm\">{k.name}</p>\n                      <p className=\"text-[10px] text-text-muted\">{k.address}</p>\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n          </div>\n          <div className=\"flex items-center gap-4 text-text-muted\">\n            <div className=\"flex items-center gap-1 text-[13px]\">\n              <MapPin className=\"w-4 h-4\" />\n              {detail.address}\n            </div>\n            <div className=\"h-4 w-px bg-border\" />\n            <div className=\"flex-1 max-w-[200px] flex items-center gap-3\">\n              <div className=\"flex-1 h-1.5 bg-[#E2E8F0] rounded-full overflow-hidden\">\n                <div \n                  className=\"h-full bg-primary\" \n                  style={{ width: `${detail.capacity}%` }}\n                />\n              </div>\n              <span className=\"text-xs font-bold text-primary\">{detail.capacity}%</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Tab Switcher */}\n      <div className=\"flex items-center border-b border-border gap-1 w-full overflow-x-auto scrollbar-hide\">\n        {([\'Staff\', \'Shift\', \'Stok\'] as const).map((tab) => (\n          <button\n            key={tab}\n            onClick={() => setActiveTab(tab)}\n            className={cn(\n              \"px-8 py-4 text-sm font-bold transition-all relative whitespace-nowrap\",\n              activeTab === tab ? \"text-primary\" : \"text-text-muted hover:text-slate-600\"\n            )}\n          >\n            {tab}\n            {activeTab === tab && (\n              <motion.div layoutId=\"underline\" className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-primary\" />\n            )}\n          </button>\n        ))}\n      </div>\n\n      {/* Tab Content */}\n      <div className=\"min-h-[400px]\">\n        <AnimatePresence mode=\"wait\">\n          {activeTab === \'Staff\' && (\n            <motion.div \n              key=\"staff\"\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              className=\"space-y-4\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-lg font-bold text-slate-700\">Kitchen Staff Member</h3>\n                <Button onClick={() => setStaffModalOpen(true)}>\n                  <Plus className=\"w-4 h-4 mr-2\" />\n                  Tambah Staff\n                </Button>\n              </div>\n              <Card className=\"p-0 overflow-hidden\">\n                <table className=\"w-full\">\n                  <thead>\n                    <tr className=\"bg-slate-50 border-b border-border\">\n                      <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Avatar</th>\n                      <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Nama Lengkap</th>\n                      <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Role</th>\n                      <th className=\"text-left p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Status</th>\n                      <th className=\"text-right p-4 text-[10px] font-bold text-text-muted uppercase tracking-widest\">Aksi</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-border\">\n                    {detail.staff?.map((s: any) => (\n                      <tr key={s.id} className=\"hover:bg-slate-50/50 transition-colors group\">\n                        <td className=\"p-4\">\n                          <img src={s.avatar} className=\"w-10 h-10 rounded-full border border-slate-200\" referrerPolicy=\"no-referrer\" />\n                        </td>\n                        <td className=\"p-4 font-bold text-slate-800\">{s.name}</td>\n                        <td className=\"p-4\">\n                          <Badge status={s.role} />\n                        </td>\n                        <td className=\"p-4\">\n                          <div className=\"flex items-center gap-1.5 font-medium text-xs text-green-600\">\n                            <span className=\"w-2 h-2 rounded-full bg-green-500\" />\n                            {s.status}\n                          </div>\n                        </td>\n                        <td className=\"p-4 text-right space-x-2\">\n                          <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 transition-opacity\">\n                            <Edit2 className=\"w-4 h-4 text-slate-400\" />\n                          </Button>\n                          <Button variant=\"ghost\" size=\"icon\" className=\"opacity-0 group-hover:opacity-100 transition-opacity\">\n                            <Trash2 className=\"w-4 h-4 text-red-400\" />\n                          </Button>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </Card>\n            </motion.div>\n          )}\n\n          {activeTab === \'Shift\' && (\n            <motion.div \n              key=\"shift\"\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              className=\"grid grid-cols-1 md:grid-cols-2 gap-6\"\n            >\n              {detail.shifts?.map((shift: any, i: number) => (\n                <Card key={i} className=\"p-6 relative overflow-hidden group\">\n                  <div className=\"absolute top-0 right-0 p-4 opacity-5\">\n                    <History className=\"w-24 h-24\" />\n                  </div>\n                  <div className=\"flex justify-between items-start mb-6\">\n                    <div>\n                      <h4 className=\"text-xl font-bold text-slate-800\">{shift.type}</h4>\n                      <p className=\"text-sm font-medium text-slate-400\">{shift.time}</p>\n                    </div>\n                    <Badge status=\"Scheduled\" />\n                  </div>\n                  <div className=\"space-y-4\">\n                    <div className=\"flex items-center justify-between text-sm\">\n                      <span className=\"text-slate-500\">Total Staff Assigned</span>\n                      <span className=\"font-bold text-slate-800\">{shift.staffCount} Orang</span>\n                    </div>\n                    <div className=\"flex items-center -space-x-2\">\n                      {shift.avatars.map((av: string, idx: number) => (\n                        <img key={idx} src={av} className=\"w-8 h-8 rounded-full border-2 border-white ring-1 ring-slate-100\" referrerPolicy=\"no-referrer\" />\n                      ))}\n                      <div className=\"w-8 h-8 rounded-full bg-slate-100 border-2 border-white flex items-center justify-center text-[10px] font-bold text-slate-400\">\n                      +{shift.staffCount - shift.avatars.length}\n                      </div>\n                    </div>\n                  </div>\n                </Card>\n              ))}\n            </motion.div>\n          )}\n\n          {activeTab === \'Stok\' && (\n            <motion.div \n              key=\"stok\"\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: 10 }}\n              className=\"space-y-6\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-lg font-bold text-slate-700\">Kitchen Stock Monitor</h3>\n                <Button variant=\"outline\" size=\"sm\">\n                  <Warehouse className=\"w-4 h-4 mr-2\" />\n                  Request Bahan\n                </Button>\n              </div>\n              <div className=\"grid grid-cols-1 gap-4\">\n                {detail.stock?.map((item: InventoryItem) => (\n                  <StockRow key={item.id} item={item} />\n                ))}\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </div>\n\n      {/* Staff Modal */}\n      <Modal isOpen={isStaffModalOpen} onClose={() => setStaffModalOpen(false)} title=\"Tambah Staff Baru\">\n        <form className=\"space-y-4\">\n          <div className=\"space-y-1\">\n            <label className=\"text-sm font-bold text-slate-600\">Nama Lengkap</label>\n            <input type=\"text\" className=\"w-full border-2 border-slate-100 rounded-lg p-3\" placeholder=\"Masukkan nama...\" />\n          </div>\n          <div className=\"space-y-1\">\n            <label className=\"text-sm font-bold text-slate-600\">Role</label>\n            <select className=\"w-full border-2 border-slate-100 rounded-lg p-3\">\n              <option>Head Chef</option>\n              <option>Sous Chef</option>\n              <option>Prep Cook</option>\n            </select>\n          </div>\n          <Button className=\"w-full py-4 mt-6\">Simpan Staff</Button>\n        </form>\n      </Modal>\n    </div>\n  );\n};\n\nconst StockRow = ({ item }: { item: InventoryItem, key?: string }) => {\n  const [isOpen, setIsOpen] = React.useState(false);\n  \n  return (\n    <Card className=\"p-0 overflow-hidden transform-gpu\">\n      <div \n        className={cn(\n          \"p-6 flex items-center gap-6 cursor-pointer hover:bg-slate-50 transition-colors\",\n          isOpen && \"bg-slate-50\"\n        )}\n        onClick={() => setIsOpen(!isOpen)}\n      >\n        <div className=\"w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-orange-500 shrink-0\">\n          <Package className=\"w-6 h-6\" />\n        </div>\n        <div className=\"flex-1 min-w-0\">\n          <h4 className=\"font-bold text-slate-800\">{item.name}</h4>\n          <div className=\"flex items-center gap-3 mt-1\">\n            <div className=\"flex-1 h-1.5 bg-slate-200 rounded-full overflow-hidden\">\n              <div \n                className={cn(\"h-full\", item.volume < 30 ? \"bg-red-500\" : \"bg-green-500\")}\n                style={{ width: `${item.volume}%` }}\n              />\n            </div>\n            <span className=\"text-xs font-bold text-slate-400\">{item.volume}%</span>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <div className=\"text-right\">\n            <p className=\"text-xs font-bold text-slate-400 uppercase\">Batches</p>\n            <p className=\"font-bold text-slate-800\">{item.batches.length}</p>\n          </div>\n          <ChevronDown className={cn(\"w-5 h-5 text-slate-300 transition-transform\", isOpen && \"rotate-180\")} />\n        </div>\n      </div>\n      \n      <AnimatePresence>\n        {isOpen && (\n          <motion.div \n            initial={{ height: 0 }}\n            animate={{ height: \'auto\' }}\n            exit={{ height: 0 }}\n            className=\"overflow-hidden bg-slate-50/50\"\n          >\n            <div className=\"p-6 pt-0 space-y-2\">\n              {item.batches.length > 0 ? (\n                item.batches.map(b => (\n                  <div key={b.id} className=\"flex items-center justify-between p-3 bg-white border border-border rounded-lg shadow-sm text-sm\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"p-2 bg-slate-50 rounded-lg\">\n                        <Warehouse className=\"w-3 h-3 text-text-muted\" />\n                      </div>\n                      <span className=\"font-bold text-text-main\">{b.container}</span>\n                      <span className=\"text-text-muted\">\342\200\242</span>\n                      <span className=\"font-medium text-text-muted\">{b.weight}</span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-text-muted\">Exp:</span>\n                      <span className=\"font-bold text-text-main\">{b.expiry}</span>\n                    </div>\n                  </div>\n                ))\n              ) : (\n                <p className=\"text-center py-4 text-xs font-bold text-text-muted italic\">No detailed batch data available</p>\n              )}\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </Card>\n  );\n}\n"
    num_lines: 336
    num_bytes: 15390
  }
}
