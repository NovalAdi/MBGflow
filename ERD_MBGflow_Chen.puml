@startdot
digraph ERD_MBGflow {
    // ======================================================================
    // ERD Chen's Notation - MBGflow Database
    // Generated from: backend/src/config/db.js
    // ======================================================================

    graph [
        rankdir=TB,
        splines=true,
        nodesep=0.35,
        ranksep=0.55,
        bgcolor="white",
        fontname="Arial",
        pad=0.3,
        dpi=150
    ];
    node [fontname="Arial", color="#333333"];
    edge [dir=none, color="#333333", penwidth=0.8];

    // ==============================================================
    //  ENTITIES (Rectangles - shape=box)
    // ==============================================================
    node [shape=box, fontsize=10, style="bold", height=0.35, margin="0.12,0.06"];

    KITCHENS;
    MENUS;
    INGREDIENTS;
    INVENTORY;
    INVENTORY_BATCHES;
    STAFF;
    PRODUCTION_PLANS;
    PRODUCTION_LOGS;
    STOCK_REQUESTS;
    WASTAGE_RECORDS;
    NOTIFICATIONS;
    STOCK_VERIFICATIONS;

    // ==============================================================
    //  RELATIONSHIPS (Diamonds - shape=diamond)
    // ==============================================================
    node [shape=diamond, fontsize=8, style="", height=0.55, width=0.9,
          margin="0.04,0.04"];

    R_menu_ing      [label="memiliki"];
    R_inv_batch     [label="memiliki"];
    R_batch_kit     [label="disimpan\ndi"];
    R_staff_kit     [label="bekerja\ndi"];
    R_pp_kit        [label="rencana\nproduksi"];
    R_pp_menu       [label="menggunakan\nmenu"];
    R_pl_kit        [label="mencatat\nlog"];
    R_notif_kit     [label="menerima\nnotif"];
    R_sv_kit        [label="verifikasi\nstok"];

    // ==============================================================
    //  ATTRIBUTES (Ellipses - shape=ellipse)
    //  PK = underlined, FK = dashed border
    // ==============================================================
    node [shape=ellipse, fontsize=7, style="", height=0.22, width=0.45,
          margin="0.04,0.02"];

    // ---------- KITCHENS ----------
    k_id       [label=<<u>id</u>>];
    k_name     [label="name"];
    k_address  [label="address"];
    k_capacity [label="capacity"];
    k_city     [label="city"];
    k_lat      [label="latitude"];
    k_long     [label="longitude"];
    k_maps     [label="maps_url"];

    // ---------- MENUS ----------
    m_id   [label=<<u>id</u>>];
    m_name [label="name"];

    // ---------- INGREDIENTS ----------
    i_id      [label=<<u>id</u>>];
    i_menuId  [label="menuId", style="dashed"];
    i_name    [label="name"];
    i_perP    [label="perPortion"];
    i_unit    [label="unit"];

    // ---------- INVENTORY ----------
    inv_id      [label=<<u>id</u>>];
    inv_name    [label="name"];
    inv_sku     [label="logistics_sku"];
    inv_base    [label="base_unit"];
    inv_hasPkg  [label="has_packaging"];
    inv_pkgN    [label="packaging_name"];
    inv_pkgC    [label="packaging_cap"];

    // ---------- INVENTORY_BATCHES ----------
    ib_id      [label=<<u>id</u>>];
    ib_invId   [label="inventoryId", style="dashed"];
    ib_kitId   [label="kitchenId", style="dashed"];
    ib_cont    [label="container"];
    ib_weight  [label="weight"];
    ib_qtyP    [label="qty_packed"];
    ib_qtyL    [label="qty_loose"];
    ib_unit    [label="unit"];
    ib_pkgCap  [label="pkg_capacity"];
    ib_pkgU    [label="pkg_unit"];
    ib_exp     [label="expiry"];

    // ---------- STAFF ----------
    s_id    [label=<<u>id</u>>];
    s_name  [label="name"];
    s_role  [label="role"];
    s_stat  [label="status"];
    s_avt   [label="avatar"];
    s_kitId [label="kitchenId", style="dashed"];
    s_email [label="email"];
    s_pass  [label="password"];

    // ---------- PRODUCTION_PLANS ----------
    pp_id      [label=<<u>id</u>>];
    pp_day     [label="day"];
    pp_menuId  [label="menuId", style="dashed"];
    pp_menuN   [label="menuName"];
    pp_kitId   [label="kitchenId", style="dashed"];
    pp_kitN    [label="kitchenName"];
    pp_port    [label="portions"];
    pp_note    [label="note"];
    pp_stat    [label="status"];
    pp_chef    [label="chefPJ"];

    // ---------- PRODUCTION_LOGS ----------
    pl_id      [label=<<u>id</u>>];
    pl_kitId   [label="kitchenId", style="dashed"];
    pl_kit     [label="kitchen"];
    pl_menu    [label="menu"];
    pl_serv    [label="servings"];
    pl_city    [label="city"];
    pl_start   [label="startTime"];
    pl_qa      [label="qaNotes"];
    pl_stat    [label="status"];

    // ---------- STOCK_REQUESTS ----------
    sr_id      [label=<<u>id</u>>];
    sr_mat     [label="material"];
    sr_amt     [label="amount"];
    sr_urg     [label="urgency"];
    sr_stat    [label="status"];
    sr_cAt     [label="createdAt"];
    sr_kitId   [label="kitchenId"];
    sr_kitN    [label="kitchenName"];
    sr_supId   [label="supplierKitId"];
    sr_supN    [label="supplierKitName"];
    sr_notes   [label="adminNotes"];

    // ---------- WASTAGE_RECORDS ----------
    w_id     [label=<<u>id</u>>];
    w_kit    [label="kitchen"];
    w_city   [label="city"];
    w_mat    [label="material"];
    w_weight [label="weight"];
    w_unit   [label="unit"];
    w_reason [label="reason"];
    w_cost   [label="cost"];
    w_date   [label="date"];

    // ---------- NOTIFICATIONS ----------
    n_id    [label=<<u>id</u>>];
    n_kitId [label="kitchenId", style="dashed"];
    n_msg   [label="message"];
    n_read  [label="isRead"];
    n_cAt   [label="createdAt"];

    // ---------- STOCK_VERIFICATIONS ----------
    sv_id    [label=<<u>id</u>>];
    sv_kitId [label="kitchenId", style="dashed"];
    sv_at    [label="verifiedAt"];
    sv_by    [label="verifiedBy"];
    sv_det   [label="details"];

    // ==============================================================
    //  ATTRIBUTE CONNECTIONS (Entity <-> Attribute)
    // ==============================================================

    // KITCHENS
    k_id       -> KITCHENS;
    k_name     -> KITCHENS;
    k_address  -> KITCHENS;
    k_capacity -> KITCHENS;
    k_city     -> KITCHENS;
    k_lat      -> KITCHENS;
    k_long     -> KITCHENS;
    k_maps     -> KITCHENS;

    // MENUS
    m_id   -> MENUS;
    m_name -> MENUS;

    // INGREDIENTS
    i_id     -> INGREDIENTS;
    i_menuId -> INGREDIENTS;
    i_name   -> INGREDIENTS;
    i_perP   -> INGREDIENTS;
    i_unit   -> INGREDIENTS;

    // INVENTORY
    inv_id     -> INVENTORY;
    inv_name   -> INVENTORY;
    inv_sku    -> INVENTORY;
    inv_base   -> INVENTORY;
    inv_hasPkg -> INVENTORY;
    inv_pkgN   -> INVENTORY;
    inv_pkgC   -> INVENTORY;

    // INVENTORY_BATCHES
    ib_id     -> INVENTORY_BATCHES;
    ib_invId  -> INVENTORY_BATCHES;
    ib_kitId  -> INVENTORY_BATCHES;
    ib_cont   -> INVENTORY_BATCHES;
    ib_weight -> INVENTORY_BATCHES;
    ib_qtyP   -> INVENTORY_BATCHES;
    ib_qtyL   -> INVENTORY_BATCHES;
    ib_unit   -> INVENTORY_BATCHES;
    ib_pkgCap -> INVENTORY_BATCHES;
    ib_pkgU   -> INVENTORY_BATCHES;
    ib_exp    -> INVENTORY_BATCHES;

    // STAFF
    s_id    -> STAFF;
    s_name  -> STAFF;
    s_role  -> STAFF;
    s_stat  -> STAFF;
    s_avt   -> STAFF;
    s_kitId -> STAFF;
    s_email -> STAFF;
    s_pass  -> STAFF;

    // PRODUCTION_PLANS
    pp_id     -> PRODUCTION_PLANS;
    pp_day    -> PRODUCTION_PLANS;
    pp_menuId -> PRODUCTION_PLANS;
    pp_menuN  -> PRODUCTION_PLANS;
    pp_kitId  -> PRODUCTION_PLANS;
    pp_kitN   -> PRODUCTION_PLANS;
    pp_port   -> PRODUCTION_PLANS;
    pp_note   -> PRODUCTION_PLANS;
    pp_stat   -> PRODUCTION_PLANS;
    pp_chef   -> PRODUCTION_PLANS;

    // PRODUCTION_LOGS
    pl_id    -> PRODUCTION_LOGS;
    pl_kitId -> PRODUCTION_LOGS;
    pl_kit   -> PRODUCTION_LOGS;
    pl_menu  -> PRODUCTION_LOGS;
    pl_serv  -> PRODUCTION_LOGS;
    pl_city  -> PRODUCTION_LOGS;
    pl_start -> PRODUCTION_LOGS;
    pl_qa    -> PRODUCTION_LOGS;
    pl_stat  -> PRODUCTION_LOGS;

    // STOCK_REQUESTS
    sr_id    -> STOCK_REQUESTS;
    sr_mat   -> STOCK_REQUESTS;
    sr_amt   -> STOCK_REQUESTS;
    sr_urg   -> STOCK_REQUESTS;
    sr_stat  -> STOCK_REQUESTS;
    sr_cAt   -> STOCK_REQUESTS;
    sr_kitId -> STOCK_REQUESTS;
    sr_kitN  -> STOCK_REQUESTS;
    sr_supId -> STOCK_REQUESTS;
    sr_supN  -> STOCK_REQUESTS;
    sr_notes -> STOCK_REQUESTS;

    // WASTAGE_RECORDS
    w_id     -> WASTAGE_RECORDS;
    w_kit    -> WASTAGE_RECORDS;
    w_city   -> WASTAGE_RECORDS;
    w_mat    -> WASTAGE_RECORDS;
    w_weight -> WASTAGE_RECORDS;
    w_unit   -> WASTAGE_RECORDS;
    w_reason -> WASTAGE_RECORDS;
    w_cost   -> WASTAGE_RECORDS;
    w_date   -> WASTAGE_RECORDS;

    // NOTIFICATIONS
    n_id    -> NOTIFICATIONS;
    n_kitId -> NOTIFICATIONS;
    n_msg   -> NOTIFICATIONS;
    n_read  -> NOTIFICATIONS;
    n_cAt   -> NOTIFICATIONS;

    // STOCK_VERIFICATIONS
    sv_id    -> STOCK_VERIFICATIONS;
    sv_kitId -> STOCK_VERIFICATIONS;
    sv_at    -> STOCK_VERIFICATIONS;
    sv_by    -> STOCK_VERIFICATIONS;
    sv_det   -> STOCK_VERIFICATIONS;

    // ==============================================================
    //  RELATIONSHIP CONNECTIONS (with Cardinality)
    // ==============================================================

    // MENUS 1 --[memiliki]-- N INGREDIENTS
    MENUS -> R_menu_ing [label="1", fontsize=8];
    R_menu_ing -> INGREDIENTS [label="N", fontsize=8];

    // INVENTORY 1 --[memiliki]-- N INVENTORY_BATCHES
    INVENTORY -> R_inv_batch [label="1", fontsize=8];
    R_inv_batch -> INVENTORY_BATCHES [label="N", fontsize=8];

    // KITCHENS 1 --[disimpan di]-- N INVENTORY_BATCHES
    KITCHENS -> R_batch_kit [label="1", fontsize=8];
    R_batch_kit -> INVENTORY_BATCHES [label="N", fontsize=8];

    // KITCHENS 1 --[bekerja di]-- N STAFF
    KITCHENS -> R_staff_kit [label="1", fontsize=8];
    R_staff_kit -> STAFF [label="N", fontsize=8];

    // KITCHENS 1 --[rencana produksi]-- N PRODUCTION_PLANS
    KITCHENS -> R_pp_kit [label="1", fontsize=8];
    R_pp_kit -> PRODUCTION_PLANS [label="N", fontsize=8];

    // MENUS 1 --[menggunakan menu]-- N PRODUCTION_PLANS
    MENUS -> R_pp_menu [label="1", fontsize=8];
    R_pp_menu -> PRODUCTION_PLANS [label="N", fontsize=8];

    // KITCHENS 1 --[mencatat log]-- N PRODUCTION_LOGS
    KITCHENS -> R_pl_kit [label="1", fontsize=8];
    R_pl_kit -> PRODUCTION_LOGS [label="N", fontsize=8];

    // KITCHENS 1 --[menerima notif]-- N NOTIFICATIONS
    KITCHENS -> R_notif_kit [label="1", fontsize=8];
    R_notif_kit -> NOTIFICATIONS [label="N", fontsize=8];

    // KITCHENS 1 --[verifikasi stok]-- N STOCK_VERIFICATIONS
    KITCHENS -> R_sv_kit [label="1", fontsize=8];
    R_sv_kit -> STOCK_VERIFICATIONS [label="N", fontsize=8];

    // ==============================================================
    //  LAYOUT HINTS (rank groups for tidy arrangement)
    // ==============================================================

    // Tier 1: Parent entities
    {rank=same; MENUS; KITCHENS; INVENTORY}

    // Tier 3: Child entities (connected via relationships)
    {rank=same; INGREDIENTS; STAFF; INVENTORY_BATCHES}

    // Tier 5: Bottom entities
    {rank=same; PRODUCTION_PLANS; PRODUCTION_LOGS; NOTIFICATIONS; STOCK_VERIFICATIONS}

    // Standalone entities (no FK)
    {rank=same; STOCK_REQUESTS; WASTAGE_RECORDS}

    // Invisible edges for horizontal ordering of Tier 1
    MENUS -> KITCHENS [style=invis];
    KITCHENS -> INVENTORY [style=invis];

    // Invisible edges for horizontal ordering of bottom tier
    PRODUCTION_PLANS -> PRODUCTION_LOGS [style=invis];
    PRODUCTION_LOGS -> NOTIFICATIONS [style=invis];
    NOTIFICATIONS -> STOCK_VERIFICATIONS [style=invis];

    // Place standalone entities at same level as bottom
    STOCK_VERIFICATIONS -> STOCK_REQUESTS [style=invis];
    STOCK_REQUESTS -> WASTAGE_RECORDS [style=invis];
}
@enddot
